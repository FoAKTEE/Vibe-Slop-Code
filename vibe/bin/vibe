#!/usr/bin/env bash
#
# vibe — the Vibe Slop Code command (the `code` of this fork).
#
# Backend resolution, first hit wins:
#   1. $VIBE_APP                                 (explicit override, must exist)
#   2. /Applications/Vibe Slop Code.app          (installed)
#   3. packaged build: vibe/.build/… or the checkout's sibling VSCode-darwin-*
#      — the NEWEST of them, never the one the glob happens to name first
#   4. dev build: vibe/vscode/scripts/code.sh    (with the pinned toolchain)
#
# Steps 2 and 3 also look for the name the app carried before the rename: renaming
# the app renames nothing on disk, so the bundle a previous package.sh wrote keeps
# working until the next one. The current name is preferred over it — a bundle under
# the current nameLong is by construction the one built after the rename — and age
# only ever separates bundles of the same name.
#
# `vibe --vibe-which` prints the chosen backend and exits without launching; with
# a `candidates:` line naming every packaged bundle of step 3, in that same order.
# Compatible with the bash 3.2 that ships with macOS.

set -u

APP_NAME="Vibe Slop Code.app"
APP_NAME_PREVIOUS="Vibe Studio Code.app"
EXE_NAME="Vibe"

# Resolve our own real location through symlinks (no `readlink -f` on macOS).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
	DIR="$(cd -P "$(dirname "$SOURCE")" > /dev/null 2>&1 && pwd)"
	SOURCE="$(readlink "$SOURCE")"
	case "$SOURCE" in
		/*) ;;
		*) SOURCE="$DIR/$SOURCE" ;;
	esac
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" > /dev/null 2>&1 && pwd)"
VIBE_ROOT="$(dirname "$BIN_DIR")"
CHECKOUT="$VIBE_ROOT/vscode"
TOOLCHAIN="$VIBE_ROOT/.toolchain/node/bin"

BACKEND=""
APP=""
TARGET=""

# The darwin packaging task ships the bundled CLI at Contents/Resources/app/bin
# under the fixed name `code` (build/gulpfile.vscode.ts renames code.sh to
# `bin/code`), so try the branded name first and fall back to the upstream one.
# Prints what would be exec'd; a bundle without any of them is not usable.
app_target() {
	local app="$1" candidate
	[ -d "$app" ] || return 1
	for candidate in \
		"$app/Contents/Resources/app/bin/vibe" \
		"$app/Contents/Resources/app/bin/code" \
		"$app/Contents/MacOS/$EXE_NAME"
	do
		if [ -x "$candidate" ]; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done
	return 1
}

resolve_app() {
	local target
	target="$(app_target "$1")" || return 1
	APP="$1"
	TARGET="$target"
	BACKEND="app"
}

# What a bundle's age is read from. The packaging task stamps the files it copies with
# a fixed 1980 date (Info.plist, Contents/MacOS/<exe>) and keeps the checkout's mtime on
# the rest, so nothing inside a bundle says when it was built — the directory the task
# writes into does. A tree without Contents/ falls back to its CLI.
bundle_stamp() {
	if [ -d "$1/Contents" ]; then
		printf '%s\n' "$1/Contents"
	else
		app_target "$1"
	fi
}

# Sorts a newline-separated list of bundles newest first. A tie, and a bundle whose age
# cannot be told, keep their place in the input (i.e. in sorted glob) order.
newest_first() {
	local rest="$1" out="" best best_stamp item item_stamp
	while [ -n "$rest" ]; do
		best=""
		best_stamp=""
		while IFS= read -r item; do
			[ -n "$item" ] || continue
			item_stamp="$(bundle_stamp "$item")"
			if [ -z "$best" ]; then
				best="$item"
				best_stamp="$item_stamp"
			elif [ -n "$item_stamp" ] && [ -n "$best_stamp" ] && [ "$item_stamp" -nt "$best_stamp" ]; then
				best="$item"
				best_stamp="$item_stamp"
			fi
		done <<-EOF
		$rest
		EOF
		out="$out$best
"
		rest="$(printf '%s' "$rest" | grep -v -x -F -- "$best" || true)"
	done
	printf '%s' "$out"
}

# 1. explicit override
if [ -n "${VIBE_APP:-}" ]; then
	if ! resolve_app "$VIBE_APP"; then
		echo "vibe: VIBE_APP does not point at a usable app bundle: $VIBE_APP" >&2
		exit 1
	fi
fi

# 2. installed app
if [ -z "$BACKEND" ]; then
	for name in "$APP_NAME" "$APP_NAME_PREVIOUS"; do
		resolve_app "/Applications/$name" && break
	done
fi

# 3. locally packaged app (gulp vscode-darwin-<arch> writes next to the checkout).
# Several can sit side by side — a fresh package next to a copy kept under another name
# — and the glob order says nothing about their age, so the newest one wins. Bundles of
# the previous name are sorted among themselves and appended, so they are only ever
# reached when there is no bundle under the current one.
CANDIDATES=""
if [ -z "$BACKEND" ]; then
	for name in "$APP_NAME" "$APP_NAME_PREVIOUS"; do
		GROUP=""
		for candidate in \
			"$VIBE_ROOT/.build/$name" \
			"$VIBE_ROOT/.build"/VSCode-darwin-*/"$name" \
			"$VIBE_ROOT"/VSCode-darwin-*/"$name"
		do
			app_target "$candidate" > /dev/null && GROUP="$GROUP$candidate
"
		done
		GROUP="$(newest_first "$GROUP")"
		[ -n "$GROUP" ] && CANDIDATES="$CANDIDATES$GROUP
"
	done
	while IFS= read -r candidate; do
		[ -n "$candidate" ] && resolve_app "$candidate" && break
	done <<-EOF
	$CANDIDATES
	EOF
fi

# 4. dev build
if [ -z "$BACKEND" ]; then
	if [ -x "$CHECKOUT/scripts/code.sh" ]; then
		BACKEND="dev"
		TARGET="$CHECKOUT/scripts/code.sh"
	else
		echo "vibe: no Vibe Slop Code found." >&2
		echo "vibe: looked for an app bundle (\$VIBE_APP, /Applications, $VIBE_ROOT)" >&2
		echo "vibe: and for a dev checkout at $CHECKOUT" >&2
		exit 1
	fi
fi

if [ "${1:-}" = "--vibe-which" ]; then
	echo "backend: $BACKEND"
	if [ "$BACKEND" = "app" ]; then
		echo "app: $APP"
	else
		echo "checkout: $CHECKOUT"
	fi
	echo "target: $TARGET"
	if [ -n "$CANDIDATES" ]; then
		LIST=""
		while IFS= read -r candidate; do
			[ -n "$candidate" ] || continue
			[ -n "$LIST" ] && LIST="$LIST | "
			LIST="$LIST$candidate"
		done <<-EOF
		$CANDIDATES
		EOF
		echo "candidates: $LIST"
	fi
	exit 0
fi

if [ "$BACKEND" = "app" ]; then
	exec "$TARGET" "$@"
fi

[ -d "$TOOLCHAIN" ] && PATH="$TOOLCHAIN:$PATH" && export PATH
exec "$TARGET" "$@"
