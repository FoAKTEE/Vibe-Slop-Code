{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./out",
		"rewriteRelativeImportExtensions": true,
		"typeRoots": [
			"./node_modules/@types"
		],
		"types": [
			"node",
			"ssh2",
			"ssh2-streams"
		]
	},
	"include": [
		"src/**/*",
		"../../src/vscode-dts/vscode.d.ts",
		"../../src/vscode-dts/vscode.proposed.resolvers.d.ts",
		"../../src/vscode-dts/vscode.proposed.contribViewsRemote.d.ts"
	]
}
